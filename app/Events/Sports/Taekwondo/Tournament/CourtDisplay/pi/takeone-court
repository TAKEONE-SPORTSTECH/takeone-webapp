#!/bin/bash
#
# The whole program running on a court display.
#
# Enrol once, then show the board forever. Everything else — which mat, when the
# queue changes, when a bout is decided — is decided on the server; this stays
# deliberately stupid so there is nothing on the device to go wrong at a venue.
#
# Run by systemd (takeone-court.service), never by hand.

set -u

CONF_DIR="/etc/takeone-court"
TOKEN_FILE="$CONF_DIR/token"
SERVER_FILE="$CONF_DIR/server"

log() { echo "[takeone-court] $*"; }

SERVER="$(cat "$SERVER_FILE" 2>/dev/null || echo 'https://takeone.bh')"
SERVER="${SERVER%/}"

# ── Wait for the network ─────────────────────────────────────────────────
# systemd's network-online.target lies often enough on a 4G dongle, which
# negotiates a session well after the interface exists. Wait for the server
# itself to answer, not for an interface to appear.
wait_for_server() {
    local waited=0
    until curl -fsS --max-time 10 -o /dev/null "$SERVER/court-display/font/anton-400-latin.woff2"; do
        waited=$((waited + 5))
        # Say so once a minute; a screen that is silently waiting looks broken.
        [ $((waited % 60)) -eq 0 ] && log "still waiting for $SERVER (${waited}s)"
        sleep 5
    done
    log "server reachable after ${waited}s"
}

# ── Enrol, once, ever ────────────────────────────────────────────────────
# Nothing is written to the SD card ahead of time, so the first boot asks the
# server who it is. What comes back can display a pairing code and nothing else
# until an organiser claims it.
enroll() {
    local body response token
    body="{\"label\":\"$(hostname | tr -cd '[:alnum:]-' | cut -c1-60)\"}"

    response="$(curl -fsS --max-time 20 -X POST \
        -H 'Content-Type: application/json' -H 'Accept: application/json' \
        -d "$body" "$SERVER/court/enroll" 2>/dev/null)" || return 1

    # No jq on a Lite image, and one field is not worth a dependency.
    token="$(printf '%s' "$response" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9]\{40\}\)".*/\1/p')"
    [ -n "$token" ] || return 1

    install -d -m 700 "$CONF_DIR"
    # Written 600 and root-owned: the token is this screen's whole identity.
    printf '%s' "$token" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    log "enrolled"
}

wait_for_server

if [ ! -s "$TOKEN_FILE" ]; then
    log "no token — enrolling"
    until enroll; do
        log "enrolment failed; retrying in 15s"
        sleep 15
    done
fi

TOKEN="$(cat "$TOKEN_FILE")"

# ── Screen hygiene ───────────────────────────────────────────────────────
# A board that blanks after ten minutes is worse than no board at all.
setterm --blank 0 --powerdown 0 >/dev/tty0 2>/dev/null || true

log "starting display"

# ── The browser engine, as an appliance ──────────────────────────────────
# cog on WPE WebKit, straight onto DRM/KMS: no desktop, no compositor, no
# browser chrome, nothing clickable. It renders the board and that is all it can
# do. Restart-on-exit is systemd's job, not a loop here.
export COG_PLATFORM=drm
export WPE_BACKEND_FDO_LIBRARY_NAME=libWPEBackend-fdo-1.0.so.1
# One process, no extra renderer: 1GB of RAM on a Pi 3B does not stretch.
export WEBKIT_USE_SINGLE_WEB_PROCESS=1

exec cog \
    --platform=drm \
    "$SERVER/court/$TOKEN"
