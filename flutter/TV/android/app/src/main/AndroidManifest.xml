<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      TAKEONE — the member's app.

      The one variant that is NOT hall furniture. It keeps its status bar, its
      rotation and its back button, because it lives in somebody's pocket rather
      than bolted to a wall, and it is the only build that asks for
      notifications: a member has to hear about a message after closing the app.

      Permissions are the set the mobile web actually uses — camera for the QR
      scanner, microphone and location for the features that ask, notifications
      for the MQTT service. Every hardware feature is required="false" so the
      app still installs on a phone that lacks one.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The QR scanner, and photo capture in the cropper. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The notification service, and the notifications it posts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- A background MQTT connection that Doze is allowed to sever is a member
         who stops being told things overnight. Asked for, never assumed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The app updates itself: MobileAppController serves /app/manifest.json,
         the installed app polls it and side-loads the new APK. Without this the
         download completes and the install silently never happens. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="TAKEONE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">

        <!-- Which build this is, and where it points. Read natively by
             MainActivity: the Dart build-time define is invisible to the platform,
             and the notification service runs with no Flutter engine at all.
             build.sh stamps the URL in. -->
        <meta-data android:name="bh.takeone.variant" android:value="app" />
        <meta-data android:name="bh.takeone.baseUrl" android:value="https://takeone.bh" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Carried over from the Capacitor shell this build replaces, verbatim:
             a proven foreground service that holds one MQTT connection and posts
             what arrives. It authenticates with the session cookie the WebView
             already holds. -->
        <service
            android:name=".MqttNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands the downloaded APK to the system installer. A file:// URI is
             refused outright since Android 7, so the update must be offered
             through a provider the installer is granted read access to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
