<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            The suite must never reach the LIVE message broker.

            Realtime topics are keyed on the numeric user id (takeone/user/{id}/…),
            and a fresh in-memory database numbers its users from 1 — so a test
            that notifies "user 1" publishes onto the real user 1's topic. With
            this left unset it fell through to .env, where REALTIME_ENABLED=true
            points at the production broker: every run sprayed invented orders,
            entries, draws and podiums into real people's browsers, complete with
            the notification sound. Measured on 2026-09-02 by subscribing as the
            real user 1 and running the suite.
        -->
        <env name="REALTIME_ENABLED" value="false"/>
        <!-- Pinned to the code default so the suite does not read the server's
             .env (stage runs it ON). Tests of the one-page design switch it on
             themselves with config(['events.unified_page' => true]). -->
        <env name="EVENT_UNIFIED_PAGE" value="false" force="true"/>
        <env name="EVENT_ONE_FORM" value="false" force="true"/>
        <env name="EVENT_PERSON_HOSTS" value="false" force="true"/>
        <env name="EVENT_FEDERATION_HOSTS" value="false" force="true"/>
        <!-- Same reason: stage runs these ON. Tests switch them on themselves. -->
        <env name="PARTIES_ENABLED" value="false" force="true"/>
        <!-- The printables designer is opt-in per test (config(['printables.enabled' => true])),
             as PrintablesTest and the batch test do: .env has it on for the box, and leaking
             that in turns the classic design room into a redirect and draws pages with Chrome. -->
        <env name="PRINTABLES_DESIGNER" value="false" force="true"/>
        <env name="PARTIES_SHADOW" value="false" force="true"/>
        <env name="PARTIES_AUTHORITY" value="" force="true"/>
        <!-- Never boot the tests from the server's cached route/event tables:
             they reflect the last `route:cache`, not the code under test (and
             give every unnamed route a generated name). Pointing at a file
             that does not exist makes Laravel read the route files. -->
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes-testing-never.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events-testing-never.php" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
